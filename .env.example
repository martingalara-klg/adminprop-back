# AdminProp backend — variables de entorno locales
# Los secretos viven en .env (no commiteado); migran a un gestor de
# secretos cuando exista infra cloud (sdd_04 §2.4).

ENVIRONMENT=local
LOG_LEVEL=INFO

# Conexiones locales (Docker Compose — issue #2)
# issue #42 -- DATABASE_URL es la conexion de RUNTIME (API + workers
# Celery): conecta como el rol `adminprop_app` (NOSUPERUSER, sujeto a RLS
# FORCE), nunca como el superusuario de Postgres -- de lo contrario RLS
# queda bypasseado y el aislamiento multi-tenant fisico (sdd_04 §2.3,
# RN-D01) nunca esta efectivamente activo. La password matchea
# APP_ROLE_PASSWORD de abajo.
DATABASE_URL=postgresql://adminprop_app:adminprop_app_local_only@localhost:5432/adminprop
# MIGRATIONS_DATABASE_URL es EXCLUSIVA de Alembic (`alembic upgrade head`,
# `make migrate`): conecta con el superusuario porque las migraciones
# necesitan DDL (CREATE TABLE/ROLE, ALTER DEFAULT PRIVILEGES) que
# `adminprop_app` no tiene ni debe tener. Ver db/migrations/env.py.
MIGRATIONS_DATABASE_URL=postgresql://adminprop:adminprop@localhost:5432/adminprop
REDIS_URL=redis://localhost:6379/0

# Roles PostgreSQL para RLS (issue #3 — docs/skills/database-migration.md,
# sdd_04 §2.3). Opcionales: si no se definen, la migracion
# 20260812_114322_setup_extensions_and_roles.py usa un valor de
# desarrollo local no sensible (paridad con el password fijo de
# POSTGRES_PASSWORD en docker/docker-compose.yml). Definir con un valor
# real antes de que exista infra cloud (CLAUDE.md §3 "gestor de
# secretos"). Los nombres deben matchear literal los campos de Settings
# (app_role_password / superadmin_role_password, sin prefijo
# ADMINPROP_ — issue #38 corrigió un desvío de esta convención).
APP_ROLE_PASSWORD=adminprop_app_local_only
SUPERADMIN_ROLE_PASSWORD=adminprop_superadmin_local_only

# Celery/Redis (issue #4 — docs/skills/async-worker.md). El REDIS_URL de
# arriba se reusa como broker y result backend (decision de implementacion,
# ver src/adminprop/workers/celery_app.py).

# Resend — unico servicio externo del MVP (issue #4,
# docs/skills/external-integrations.md, spec_notificaciones.md §Email).
# Obtener una key real en https://resend.com/api-keys (gratis hasta 100
# emails/dia). El placeholder de abajo no es un secreto real; nunca llamar
# a Resend real desde tests/CI (siempre fixtures — ver tests/fixtures/external/).
RESEND_API_KEY=re_local_dev_placeholder

# Auth — JWT RS256 (issue #6, sdd_04 §2.2). Generar el par de claves con
# RUNBOOK-LOCAL-001-backend.md §2.3 (`openssl genrsa` / `openssl rsa
# -pubout`); nunca commitear `keys/` (ya en .gitignore). Los nombres de
# estas variables deben matchear literal los campos de Settings
# (jwt_private_key_path / jwt_public_key_path) — ver issue #38.
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem

# El resto de la config de auth (algoritmo, TTLs de access/refresh,
# cookies, lockout, rate limit) tiene defaults de sdd_03 §1 / sdd_04
# §2.2/§2.5 en Settings (src/adminprop/config.py) — sobreescribir acá
# solo si un ambiente necesita un valor distinto:
# JWT_ALGORITHM=RS256
# JWT_ACCESS_TOKEN_TTL_SECONDS=28800
# JWT_REFRESH_TOKEN_TTL_DAYS=30
# COOKIE_SECURE=true
# COOKIE_DOMAIN=
# LOGIN_LOCKOUT_MAX_ATTEMPTS=5
# LOGIN_LOCKOUT_WINDOW_SECONDS=600
# LOGIN_LOCKOUT_DURATION_SECONDS=1800
# LOGIN_RATE_LIMIT_MAX=10
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=600
# FORGOT_PASSWORD_RATE_LIMIT_MAX=5
# FORGOT_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=3600
# REFRESH_RATE_LIMIT_MAX=60
# REFRESH_RATE_LIMIT_WINDOW_SECONDS=3600

# Superadmin — organizaciones + invitacion de owner (issue #7,
# spec_module_00_superadmin.md). El link de invitacion apunta al
# frontend (adminprop-front, Vite — puerto 5173 en local).
FRONTEND_BASE_URL=http://localhost:5173
# RF-03: expiracion de la invitacion de owner (horas).
# INVITATION_TTL_HOURS=72

# Activacion de cuenta + forgot/reset password (issue #8,
# spec_module_00_superadmin.md "Flujo de Activacion de Cuenta" +
# sdd_03 §1). Token de reset en Redis: TTL logico 1h + ventana de
# retencion fisica mas larga (permite distinguir 404 de 410
# RESET_TOKEN_EXPIRED en GET /auth/reset-password/:token). Defaults en
# Settings (src/adminprop/config.py) -- sobreescribir solo si un
# ambiente necesita un valor distinto:
# PASSWORD_RESET_TOKEN_TTL_SECONDS=3600
# PASSWORD_RESET_TOKEN_GRACE_SECONDS=86400

# Cifrado columnar pgcrypto AES-256 (issue #12, sdd_04 §2.4,
# shared/encryption/pgcrypto.py) — usada por `landlords.bank_info`
# (datos bancarios de terceros). El valor de abajo NO es un secreto
# real; migra a un gestor de secretos cuando exista infra cloud
# (CLAUDE.md §3/§8).
ENCRYPTION_KEY=local_dev_encryption_key_change_me

# CORS (issue #90, sdd_04 §2.4a). Deshabilitado por default -- sin
# definir esta variable, CORSMiddleware NO se registra y el comportamiento
# actual queda intacto (dev local usa el proxy de Vite, sin necesidad de
# CORS). Definir solo cuando front y API tengan dominios reales: lista de
# origenes EXACTOS separados por coma (nunca "*", incompatible con
# allow_credentials=True). Recordar que las cookies de sesion son
# SameSite=Lax (decision #43): CORS solo no habilita front y API en
# dominios cruzados, el despliegue recomendado sigue siendo mismo origen
# (proxy en el server del front).
# CORS_ALLOWED_ORIGINS=https://app.adminprop.example.com,https://admin.adminprop.example.com

# Storage local de adjuntos -- mantenimiento (issue #26,
# docs/skills/tenant-isolation.md §"Storage de archivos con aislamiento
# per-tenant"). Filesystem local via volumen Docker
# (docker/docker-compose.yml, servicio `api`); overridable solo para
# tests (tmp_path). El valor de abajo NO es un secreto.
# ATTACHMENTS_DIR=/data/adminprop-storage

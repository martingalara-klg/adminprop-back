# AdminProp backend — variables de entorno locales
# Los secretos viven en .env (no commiteado); migran a un gestor de
# secretos cuando exista infra cloud (sdd_04 §2.4).

ENVIRONMENT=local
LOG_LEVEL=INFO

# Conexiones locales (Docker Compose — issue #2)
DATABASE_URL=postgresql://adminprop:adminprop@localhost:5432/adminprop
REDIS_URL=redis://localhost:6379/0

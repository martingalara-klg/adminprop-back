# docker/Dockerfile.worker — imagen compartida por notification_worker,
# documents_worker y beat (issue #2; los workers en sí llegan con el
# issue #4 — CLAUDE.md §3, sdd_04 §1.3). Mismo entorno que la API para no
# duplicar wheels; el comando de arranque lo define docker-compose.yml
# por servicio (celery worker -Q ... / celery beat ...), no esta imagen.
FROM python:3.11-slim

WORKDIR /app

# issue #89 -- mismo bloque que docker/Dockerfile.api (issue #24):
# `documents_worker` importa transitivamente WeasyPrint
# (`settlements.exports` -> `shared/pdf/renderer.py` -> `weasyprint`), asi
# que esta imagen necesita las mismas libs de sistema. Sin esto el worker
# muere con `OSError: cannot load library 'gobject-2.0-0'` antes incluso
# de llegar al import de las tareas de Celery.
RUN apt-get update \
    && apt-get install --no-install-recommends -y \
        libpango-1.0-0 \
        libpangocairo-1.0-0 \
        libgdk-pixbuf-2.0-0 \
        libffi-dev \
        shared-mime-info \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY src ./src
COPY tests ./tests

RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -e ".[dev]"

# Sin CMD por default: docker-compose.yml fija el comando real (worker de
# notificaciones, worker de documentos o beat) por servicio.
